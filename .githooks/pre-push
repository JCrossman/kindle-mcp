#!/bin/sh
# Every commit that is about to leave this machine is checked: its message and what it adds, even if a later
# commit removes it again (GitHub keeps the old commits reachable by their hash).
top="$(git rev-parse --show-toplevel)"
node "$top/scripts/privacy-check.mjs" || exit 1
zero="0000000000000000000000000000000000000000"
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] && continue
  node "$top/scripts/privacy-check.mjs" --range "$local_sha" --not --remotes || exit 1
done
